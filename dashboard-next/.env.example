# Realtime Database REST source
# Example: https://my-project-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_RTDB_URL=
FIREBASE_RTDB_PATH=lora-readings

# Optional auth for private RTDB rules.
# Prefer a short-lived ID token. Legacy database secrets also work if your project still supports them.
FIREBASE_ID_TOKEN=
FIREBASE_DATABASE_SECRET=

# Firestore REST source, used only if FIREBASE_RTDB_URL is empty.
FIREBASE_FIRESTORE_PROJECT_ID=
FIREBASE_FIRESTORE_COLLECTION=lora-readings
FIREBASE_BEARER_TOKEN=
FIREBASE_API_KEY=

# Recommended for Vercel server-side access to private Firestore rules.
# Paste the full service account JSON, or its base64-encoded value.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional public web app config, useful if a client-side Firebase SDK is added later.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Dashboard behavior
FIREBASE_LIMIT=100
NEXT_PUBLIC_DASHBOARD_REFRESH_MS=15000
